# T.I.T.A.N. Configuration

# Cloud Model Configuration (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Model Configuration (FLM / Local NPU Server)
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_ENDPOINT=http://127.0.0.1:8000/v1
LOCAL_MODEL_NAME=local-npu-model

# Agent Behavior
TITAN_MODE=hybrid # 'hybrid', 'cloud_only', 'local_only'
WAKE_WORD=titan
VOICE_ENABLED=false
SPEECH_RATE=175

# Storage
TITAN_DATA_DIR=data
